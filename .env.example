# ==========================================
# DEV ENVIRONMENT FOR: <Customer's_name>
# ==========================================
# Copy this file to .env and fill in the values.

# Operating mode: 'development' (single version) or 'upgrade' (two versions)
ODOO_MODE=development

# --- Development mode --------------------------------------------------
# Odoo version to work with (e.g. 17.0)
ODOO_VERSION=<version>

# --- Upgrade mode ------------------------------------------------------
# Odoo source version (the version you're upgrading FROM, e.g. 17.0)
ODOO_SOURCE_VERSION=
# Odoo target version (the version you're upgrading TO, e.g. 18.0)
ODOO_TARGET_VERSION=

# --- Shared ------------------------------------------------------------
# Docker Compose project name — used as prefix for container names
COMPOSE_PROJECT_NAME=<customer_name>

# Absolute path to the customer's custom modules repo (e.g. ~/Odoo/Repos/acme-addons)
CUSTOMER_REPO=~/Odoo/Repos/<customer_repo_folder>

# Ports exposed to the host — change if running multiple clients simultaneously
ODOO_PORT=8069
ODOO_DEBUG_PORT=5678
# PGADMIN_PORT=5050

# Name of the database to work with
ODOO_DB_NAME=<database_name>

# Enable remote debugger on port 5678 — set to false to start without debugpy overhead
ODOO_DEBUG=true

# Extra arguments always passed to odoo-bin (e.g. --dev=all for hot reload)
ODOO_EXTRA_ARGS=

# --- Restore / dumps -----------------------------------------------------
# Path where database dumps are read from (make restore / make restore-external).
# Defaults to ~/Odoo/Dumps. If the dump lives on the external disk (see
# EXTERNAL_DISK_PATH below), override this to point there too, e.g.
# DUMPS_PATH=/Volumes/ExternalDisk/Dumps
# DUMPS_PATH=~/Odoo/Dumps

# Redirect Postgres data + filestore to an external disk — for restoring large dumps.
# Leave empty to use the internal disk (default). Path must be a mounted volume with
# a filesystem that supports Unix permissions (APFS or Mac OS Extended/HFS+) —
# NOT exFAT/FAT32. Use with: make restore-external dump=backup.zip
# EXTERNAL_DISK_PATH=

# --- AI Agent (optional) -----------------------------------------------
# Set to true only if the client has contractually approved AI access to their code
AGENT_CUSTOMER_ACCESS=false

# Path to CLAUDE.md system prompt (your own repo/file — see setup.sh)
# CLAUDE_PATH=~/Odoo/.claude-md/CLAUDE.md
